{
  "manifest_version": 3,
  "name": "Candidex",
  "version": "1.0.0",
  "key": "",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Open Candidex"
  },
  "permissions": [
    "scripting",
    "identity",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.deepseek.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "oauth2": {
    "client_id": "",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "candidex_logo.png",
        "ai_capture.png",
        "*.woff",
        "*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
  }
}