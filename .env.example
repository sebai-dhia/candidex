# Google OAuth client IDs — copy this file to `.env` and fill in your own values.
# Never commit `.env`. These are injected at build time into the extension ZIP.
# Chrome cannot read `.env` at runtime.

# Chrome Extension OAuth client (manifest.json → chrome.identity.getAuthToken)
CANDIDEX_CHROME_OAUTH_CLIENT_ID=

# Web application OAuth client (Opera, Edge, Brave, Vivaldi → launchWebAuthFlow)
# Authorized redirect URI: https://<your-extension-id>.chromiumapp.org/
CANDIDEX_WEB_FLOW_OAUTH_CLIENT_ID=