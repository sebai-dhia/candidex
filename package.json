{
  "name": "candidex",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prepare:oauth": "node scripts/prepare-oauth.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "prestart": "node scripts/prepare-oauth.mjs",
    "prebuild": "node scripts/prepare-oauth.mjs",
    "prewatch": "node scripts/prepare-oauth.mjs",
    "pretest": "node scripts/prepare-oauth.mjs",
    "pretypecheck": "node scripts/prepare-oauth.mjs",
    "build": "npm run build:extension && ng build",
    "watch": "npm run build:extension && ng build --watch --configuration development",
    "watch:extension": "node scripts/build-extension.mjs --watch",
    "lint": "node scripts/check-import-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "format:check": "prettier --check \"src/contracts/**/*.{ts,js,scss,html,json}\" \"src/domain/**/*.{ts,js,scss,html,json}\" \"src/migration-fixtures/**/*.{ts,js,scss,html,json}\"",
    "package:verify": "node scripts/package-verify.mjs",
    "assets": "node scripts/generate-store-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/prepare-oauth.mjs --require && npm run build:extension && ng build && npm run package:verify && node scripts/zip.js"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.0.3",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@lucide/angular": "^1.21.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@types/chrome": "^0.1.43",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.12",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
